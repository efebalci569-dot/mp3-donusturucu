{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Uygulamayı başlat",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python",
            "args": ["backend/launcher.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Testler",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python",
            "args": ["-m", "pytest", "-q"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
